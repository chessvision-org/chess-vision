{
  "name": "chess-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:css && node scripts/build-lib.mjs && tsx watch app/server.ts",
    "start": "tsx app/server.ts",
    "build:css": "sass app/styles/main.scss public/styles/main.css --no-source-map",
    "build:lib": "node scripts/build-lib.mjs",
    "build": "pnpm build:css && node scripts/build-lib.mjs && pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:worker": "tsc --noEmit -p workers/analytics/tsconfig.json",
    "lint": "eslint . --max-warnings=0 && stylelint \"app/**/*.scss\" \"ui/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"app/**/*.scss\" \"ui/**/*.scss\" --fix",
    "lint:ci": "eslint . --max-warnings=0 && stylelint \"app/**/*.scss\" \"ui/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:ci": "prettier --check .",
    "test": "node --experimental-strip-types --import ./scripts/register-test-aliases.mjs --test \"ui/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "validate": "pnpm typecheck && pnpm typecheck:worker && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@chessviewer-org/chess-viewer": "^1.2.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.8.3",
    "sass": "^1.101.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "node-fetch": "^3.3.2"
    }
  }
}
