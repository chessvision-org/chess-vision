{
  "name": "chess-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:css && node scripts/build-lib.mjs && tsx watch app/server.ts",
    "start": "tsx app/server.ts",
    "build:css": "sass app/styles/main.scss public/styles/main.css --no-source-map",
    "build:lib": "node scripts/build-lib.mjs",
    "build": "pnpm build:css && node scripts/build-lib.mjs && pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "pnpm lint:code && pnpm lint:style",
    "lint:code": "oxlint",
    "lint:style": "stylelint \"app/**/*.scss\" \"ui/**/*.scss\"",
    "lint:fix": "pnpm lint:code --fix && pnpm lint:style --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --experimental-strip-types --import ./scripts/register-test-aliases.mjs --test \"ui/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/update-csp-hash.mjs && pnpm prerender",
    "build:vite": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "build:analyze": "vite build && npx vite-bundle-visualizer",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:ci": "prettier --check .",
    "test": "node --experimental-strip-types --import ./scripts/register-test-aliases.mjs --test \"tests/*.test.ts\"",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@chessviewer-org/chess-viewer": "^1.2.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "sass": "^1.101.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "optionalDependencies": {
    "puppeteer": "^25.1.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "node-fetch": "^3.3.2"
    }
  }
}
