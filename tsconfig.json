{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@lib/*": ["ui/lib/src/*"],
      "@lib/css/*": ["ui/lib/css/*"],
      "@lib/assets/*": ["ui/lib/assets/*"],
      "@auth": ["ui/auth/src"],
      "@auth/*": ["ui/auth/src/*"],
      "@utils": ["ui/lib/src/utils"],
      "@utils/*": ["ui/lib/src/utils/*"],
      "@constants": ["ui/lib/src/constants"],
      "@constants/*": ["ui/lib/src/constants/*"],
      "@app-types": ["ui/lib/src/types"],
      "@app-types/*": ["ui/lib/src/types/*"]
    }
  },
  "include": [
    "app",
    "ui/lib/src/utils/a11yUtils.ts",
    "ui/lib/src/utils/canvasExporter.ts",
    "ui/lib/src/utils/canvasRenderer.ts",
    "ui/lib/src/utils/coordinateCalculations.ts",
    "ui/lib/src/utils/exportRaster.ts",
    "ui/lib/src/utils/exportState.ts",
    "ui/lib/src/utils/imageOptimizer.ts",
    "ui/lib/src/utils/logger.ts",
    "ui/lib/src/utils/pageScroll.ts",
    "ui/lib/src/utils/pieceUtils.ts",
    "ui/lib/src/utils/saveBlob.ts",
    "ui/lib/src/utils/svgExporter.ts",
    "ui/lib/src/utils/workerRasterExport.ts",
    "ui/lib/src/utils/themeMode.ts",
    "ui/lib/src/constants",
    "ui/lib/src/types"
  ],
  "exclude": [
    "supabase",
    "node_modules",
    "dist",
    "build",
    "modules",
    "server",
    "tests",
    "**/*.tsx",
    "ui/lib/src/utils/archiveManager.ts",
    "ui/lib/src/utils/databaseSearch.ts",
    "ui/lib/src/utils/historyUtils.ts",
    "ui/lib/src/utils/syncHydration.ts",
    "ui/lib/src/utils/index.ts",
    "ui/lib/src/utils/svgRasterWorker.ts"
  ]
  "include": ["src", "tests"],
  "exclude": ["supabase", "node_modules", "dist", "build"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
